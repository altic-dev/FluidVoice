{
  "name": "@fluidvoice/opencode",
  "version": "0.1.0",
  "description": "FluidVoice voice-reply integration for OpenCode - answer your coding agent by voice",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/server.ts --outdir ./dist --target node",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "fluidvoice",
    "voice",
    "dictation",
    "ai",
    "coding-agent"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/altic-dev/FluidVoice",
    "directory": "opencode-plugin"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "event",
      "tool"
    ]
  },
  "oc-plugin": ["server"],
  "files": ["dist"],
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.34",
    "@opencode-ai/plugin-v2": "npm:@opencode-ai/plugin@0.0.0-beta-19271",
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
