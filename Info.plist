<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleVersion</key>
		<string>16</string>
	<key>CFBundleShortVersionString</key>
		<string>1.6.5</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>Voix needs Accessibility permission only for optional global dictation hotkeys. Practice sessions work without it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voix needs microphone access to record your speech for practice sessions and transcription. Your audio is processed locally and never sent to external servers.</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Voix needs permission to control system events for managing launch at startup settings.</string>
	<key>POSTHOG_API_KEY</key>
	<string></string>
	<key>POSTHOG_HOST</key>
	<string>https://eu.i.posthog.com</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Voix uses on-device speech recognition to transcribe your speech quickly and privately.</string>
</dict>
</plist>
